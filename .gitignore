# Local scratch notes (not published; use GitHub Issues)
.scratch/
cache/
run-*/
*.jsonl
.tmp/

# Packaging artifacts and installed dependencies (never commit).
node_modules/
*.tgz
pack/

# Reusable runtime source and checked-in event fixtures are not run caches.
!lib/run-runtime/
!tools/run-runtime/
!tests/run-runtime/
!tests/agent-run/fixtures/*.jsonl

# Beads / Dolt local store (this repo uses GitHub Issues; do not commit bd init)
.beads/
.dolt/
*.db
.beads-credential-key
